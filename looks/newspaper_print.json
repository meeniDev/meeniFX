{
  "format": "mfxlook",
  "version": 1,
  "id": "newspaper_print",
  "name": "Newspaper Print",
  "description": "Ink hatching, coarse dots and warm aged paper",
  "stack": [
    {"effect_id": "crosshatch", "params": {"spacing": 5, "density": 62, "paper": "#EFE6D2", "ink": "#29241D"}},
